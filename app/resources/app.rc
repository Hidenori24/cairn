// アイコン・マニフェスト・バージョン情報
#include <winver.h>

IDI_APP ICON "app.ico"
1 24 "app.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "041104B0"
    BEGIN
      VALUE "FileDescription", "Project Roadmap"
      VALUE "FileVersion", "0.1.0"
      VALUE "ProductName", "Project Roadmap"
      VALUE "ProductVersion", "0.1.0"
      VALUE "OriginalFilename", "ProjectRoadmap.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x411, 1200
  END
END
