# 正解データ・サンプルは改行コード（CRLF）を含めてバイト単位で照合するため、git に変換させない
golden/** -text
# 版ごとの互換の見本（tests/compat/）も、CSV の CRLF と設定 JSON をバイト単位で照合する
tests/compat/** -text
app/resources/*.csv -text
core/samples/*.csv -text
*.cpp text eol=lf
*.hpp text eol=lf
*.h text eol=lf
*.txt text eol=lf
*.md text eol=lf
*.cmake text eol=lf
*.sh text eol=lf
CMakeLists.txt text eol=lf
# 配布物の説明はメモ帳で読むので CRLF
packaging/** text eol=crlf
