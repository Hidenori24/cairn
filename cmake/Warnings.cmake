# 自前のターゲットにだけ付ける警告・サニタイザの設定（サードパーティには付けない）
function(roadmap_set_warnings target)
  if(MSVC)
    target_compile_options(${target} PRIVATE /W4 /utf-8 /permissive- /Zc:__cplusplus)
    if(ROADMAP_WERROR)
      target_compile_options(${target} PRIVATE /WX)
    endif()
  else()
    target_compile_options(${target} PRIVATE -Wall -Wextra -Wpedantic)
    if(ROADMAP_WERROR)
      target_compile_options(${target} PRIVATE -Werror)
    endif()
  endif()
  if(ROADMAP_SANITIZE AND NOT MSVC)
    target_compile_options(${target} PRIVATE -fsanitize=address,undefined -fno-omit-frame-pointer -fno-sanitize-recover=undefined)
    target_link_options(${target} PRIVATE -fsanitize=address,undefined)
    target_compile_definitions(${target} PRIVATE ROADMAP_SANITIZED)
  endif()
endfunction()
