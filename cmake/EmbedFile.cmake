# ファイルを C++ のバイト列として埋め込む: roadmap_embed_file(<out.cpp> <関数名> <入力ファイル>)
function(roadmap_embed_file out fn in)
  file(READ "${in}" hex HEX)
  string(LENGTH "${hex}" n)
  math(EXPR bytes "${n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "'\\\\x\\1'," body "${hex}")
  string(REGEX REPLACE "(('\\\\x[0-9a-f][0-9a-f]',){32})" "\\1\n" body "${body}")
  file(WRITE "${out}.tmp" "// 自動生成（${in}）。編集しない\n#include <string_view>\nnamespace roadmap::samples {\nstatic const char k_${fn}[] = {\n${body}'\\0'};\nstd::string_view ${fn}() { return {k_${fn}, ${bytes}}; }\n}  // namespace roadmap::samples\n")
  configure_file("${out}.tmp" "${out}" COPYONLY)
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${in}")
endfunction()
