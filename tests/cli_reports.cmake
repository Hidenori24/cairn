# CLI から GUI と同じ報告を作り、入力を変えず、失敗時に出力を残さないこと。
file(MAKE_DIRECTORY "${OUT}")
file(REMOVE "${OUT}/bad.html" "${OUT}/bad.md")
set(input "${OUT}/日本語 sample.csv")
file(COPY_FILE "${SAMPLE}" "${input}")
file(SHA256 "${input}" input_hash)

function(run_cli expected)
  execute_process(COMMAND "${RMCLI}" ${ARGN}
    RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
  if(NOT "${rc}" STREQUAL "${expected}")
    message(FATAL_ERROR "終了コード ${expected} を期待（実際 ${rc}）: ${ARGN}\n${stdout}\n${stderr}")
  endif()
  set(stdout "${stdout}" PARENT_SCOPE)
  set(stderr "${stderr}" PARENT_SCOPE)
endfunction()

function(contains text part)
  string(FIND "${text}" "${part}" at)
  if(at EQUAL -1)
    message(FATAL_ERROR "出力に見つかりません: ${part}")
  endif()
endfunction()

function(excludes text part)
  string(FIND "${text}" "${part}" at)
  if(NOT at EQUAL -1)
    message(FATAL_ERROR "出力に含めないものがあります: ${part}")
  endif()
endfunction()

run_cli(0 report --help)
contains("${stdout}" "--sections")
run_cli(0 weekly --help)
contains("${stdout}" "--period")

run_cli(0 report "${input}" --base 2026-10-19 --name "試験 <&>" -o "${OUT}/report.html")
file(READ "${OUT}/report.html" html)
contains("${html}" "試験 &lt;&amp;&gt;")
contains("${html}" "<h2>ガント</h2>")
contains("${html}" "<h2>統計</h2>")
contains("${html}" "<h2>リスト</h2>")
contains("${html}" "A4 landscape")
contains("${html}" "2026/10/19")
excludes("${stdout}" "<!DOCTYPE")

run_cli(0 report "${input}" --base=2026-10-19 --sections gantt --zoom month --color-by asg --dark --no-deps)
contains("${stdout}" "<h2>ガント</h2>")
contains("${stdout}" "拡大率: 月")
contains("${stdout}" "色分け: 担当者")
excludes("${stdout}" "<h2>統計</h2>")
excludes("${stdout}" "<h2>リスト</h2>")
run_cli(0 report "${input}" --base 2026-10-19 --sections stats,list -o -)
contains("${stdout}" "<h2>統計</h2>")
contains("${stdout}" "<h2>リスト</h2>")
excludes("${stdout}" "<h2>ガント</h2>")

run_cli(0 weekly "${input}" --base 2026-10-19 --name "試験" -o "${OUT}/weekly.md")
file(READ "${OUT}/weekly.md" md)
contains("${md}" "# 試験 週次レポート")
contains("${md}" "10/19")
contains("${md}" "10/25")
run_cli(0 weekly "${input}" --base 2026-10-19 --period last --format html)
contains("${stdout}" "<html lang=\"ja\">")
contains("${stdout}" "10/12")
contains("${stdout}" "10/18")
contains("${stdout}" "日本語 sample")
run_cli(0 weekly "${input}" --base 2026-10-19 --from 2026-10-01 --to 2026-10-10 -o "${OUT}/range.md")
file(READ "${OUT}/range.md" md)
contains("${md}" "10/1")
contains("${md}" "10/10")

foreach(pair IN ITEMS "sections;bogus" "sections;gantt," "zoom;bogus" "color-by;bogus" "base;2026-02-30" "level;1x" "sectons;gantt")
  run_cli(2 report "${input}" --${pair} -o "${OUT}/bad.html")
endforeach()
run_cli(2 report "${input}" "${input}" -o "${OUT}/bad.html")
run_cli(2 report "${input}" --base --out "${OUT}/bad.html")
run_cli(2 report "${input}" --dark=false -o "${OUT}/bad.html")
run_cli(2 report "${input}" --sections= -o "${OUT}/bad.html")
run_cli(2 report "${input}" -o "${input}")
run_cli(2 report "${input}" --out=)
run_cli(2 weekly "${input}" --format bogus -o "${OUT}/bad.md")
run_cli(2 weekly "${input}" --period bogus -o "${OUT}/bad.md")
run_cli(2 weekly "${input}" --from 2026-10-01 -o "${OUT}/bad.md")
run_cli(2 weekly "${input}" --to 2026-10-10 -o "${OUT}/bad.md")
run_cli(2 weekly "${input}" --from 2026-02-30 --to 2026-10-10 -o "${OUT}/bad.md")
run_cli(2 weekly "${input}" --period last --from 2026-10-01 --to 2026-10-10 -o "${OUT}/bad.md")
run_cli(2 weekly "${input}" --format html -o "${OUT}/bad.md")
run_cli(2 report "${OUT}/missing.csv" -o "${OUT}/bad.html")
file(COPY_FILE "${input}" "${OUT}/source.html")
run_cli(2 report "${OUT}/source.html" -o "${OUT}/./source.html")
file(SHA256 "${OUT}/source.html" source_hash)
if(NOT "${input_hash}" STREQUAL "${source_hash}")
  message(FATAL_ERROR "拡張子が HTML の入力 CSV が書き換わりました")
endif()
file(WRITE "${OUT}/holidays.html" "2026-10-20\n")
run_cli(2 report "${input}" --holidays "${OUT}/holidays.html" -o "${OUT}/holidays.html")
file(READ "${OUT}/holidays.html" holidays)
if(NOT holidays STREQUAL "2026-10-20\n")
  message(FATAL_ERROR "休業日ファイルが書き換わりました")
endif()
if(EXISTS "${OUT}/bad.html" OR EXISTS "${OUT}/bad.md")
  message(FATAL_ERROR "失敗したコマンドが出力ファイルを残しました")
endif()
file(SHA256 "${input}" after_hash)
if(NOT "${input_hash}" STREQUAL "${after_hash}")
  message(FATAL_ERROR "入力 CSV が書き換わりました")
endif()
